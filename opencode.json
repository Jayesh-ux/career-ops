      "node process-quality.mjs*": "allow",
      "node followup-seed.mjs*": "allow",
      "node merge-tracker.mjs*": "allow",
      "node dedup-tracker.mjs*": "allow",
      "node normalize-statuses.mjs*": "allow",
      "node verify-pipeline.mjs*": "allow",
      "node set-status.mjs*": "allow",
